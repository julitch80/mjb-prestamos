{
  "manifest_version": 3,
  "name": "MJB → Máster 2000 · Centros de interés",
  "version": "1.1.0",
  "description": "Lleva las valoraciones de centros de interés de MJB a la hoja optativa de la planilla del Máster 2000, con vista previa.",
  "permissions": [
    "identity"
  ],
  "host_permissions": [
    "https://*.master2000.net/*",
    "https://us-central1-mjb-prestamos.cloudfunctions.net/*",
    "https://identitytoolkit.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "304813951301-icjvv9g87g2ihu9k9g89behhfkq5lafa.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.master2000.net/academicodocente/panel.php*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}