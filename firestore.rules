// ⛔ ARCHIVO COMPARTIDO — proyecto Firebase 'mjb-prestamos'
//
// Este proyecto aloja DOS modulos: prestamos (este repo) y asistencia (repo
// aparte). Firestore admite UN SOLO archivo de reglas por proyecto: el ultimo
// despliegue REEMPLAZA todo lo anterior, no lo fusiona.
//
// Por eso:
//   - NO despliegues estas reglas desde el repo de asistencia, ni las de
//     asistencia desde aqui. Quien lo haga deja al otro modulo sin permisos.
//   - Cualquier coleccion nueva debe agregarse a ESTE archivo unificado antes
//     de desplegar. La regla catch-all del final niega todo lo no declarado.
//
// Lo mismo aplica a las funciones: las de prestamos viven en el codebase
// 'default' (ver firebase.json). Un `firebase deploy --only functions` a secas
// desde otro repo las BORRA — incluidas beforecreated/beforesignedin, que son
// las que restringen el acceso al dominio institucional. Despliega siempre
// acotando el codebase: `--only functions:default` o `--only functions:asistencia`.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function callerEmail() {
      return request.auth.token.email.lower();
    }
    function isInstitutional() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && callerEmail().matches('.*@iemanueljbetancur[.]edu[.]co');
    }
    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(callerEmail())).data;
    }
    function isActiveUser() {
      return isInstitutional()
        && exists(/databases/$(database)/documents/users/$(callerEmail()))
        && callerDoc().active == true;
    }
    function isSuper() {
      return isActiveUser() && callerDoc().role == 'superusuario';
    }
    // Valida el mapa `adjunto` opcional de un mensaje (imagen, audio o
    // archivo subido a Cloud Storage). El límite de 10 MB espeja el de
    // storage.rules.
    function adjuntoValido(a) {
      return a.tipo in ['imagen', 'audio', 'archivo']
        && a.url is string
        && a.nombre is string
        && a.bytes is number && a.bytes > 0 && a.bytes <= 10485760
        && a.keys().hasOnly(['tipo', 'url', 'nombre', 'bytes', 'duracionSeg'])
        && (!('duracionSeg' in a) || a.duracionSeg is number);
    }

    function canAccessChannel(ch) {
      return ch.type == 'general'
        || (ch.type == 'rol'
            && (callerDoc().role in ch.allowedRoles || callerDoc().role == 'superusuario'))
        || (ch.type == 'directo' && callerEmail() in ch.members)
        || (ch.type == 'segmento'
            && (callerDoc().role in ['coordinador', 'rectora', 'superusuario']
                || ((ch.sede == null || callerDoc().sede == ch.sede)
                    && (ch.jornada == null || callerDoc().jornada == ch.jornada || callerDoc().jornada == 'ambas'))))
        || (ch.type == 'grupo' && callerEmail() in ch.members);
    }

    match /users/{email} {
      allow read: if isActiveUser();
      allow create: if isSuper()
        && email == email.lower()
        && email.matches('.*@iemanueljbetancur[.]edu[.]co')
        && request.resource.data.email == email
        && request.resource.data.role in ['docente', 'coordinador', 'superusuario', 'rectora']
        && request.resource.data.active is bool
        && request.resource.data.displayName is string;
      allow update: if isSuper()
        && request.resource.data.diff(resource.data).affectedKeys()
             // 'asistenciaConsulta' habilita la consulta ampliada del modulo de
             // asistencia (ver asisConsultaAmpliada mas abajo): cargos de apoyo sin
             // grupo que LEEN todas las planillas y no escriben nada. Sin este campo
             // en la lista, la bandera solo se podria poner a mano desde la consola
             // de Firebase, porque el panel de superusuario escribe con updateDoc y
             // la regla se lo rechazaria. No abre un camino de escalada nuevo: quien
             // puede tocar esto ya puede cambiar roles.
             .hasOnly(['displayName', 'role', 'active', 'replacedBy', 'replacedAt', 'slotId', 'sede', 'jornada', 'asistenciaConsulta'])
        && !(email == callerEmail()
             && (request.resource.data.role != resource.data.role
                 || request.resource.data.active != resource.data.active));
      allow delete: if false;
      match /readStates/{channelId} {
        allow read, write: if isActiveUser() && callerEmail() == email;
      }
    }

    match /channels/{channelId} {
      allow read: if isActiveUser() && canAccessChannel(resource.data);
      allow create: if isActiveUser() && (
        (request.resource.data.type in ['general', 'rol'] && isSuper())
        ||
        (request.resource.data.type == 'directo'
          && request.resource.data.members.size() == 2
          && callerEmail() in request.resource.data.members
          && exists(/databases/$(database)/documents/users/$(request.resource.data.members[0]))
          && exists(/databases/$(database)/documents/users/$(request.resource.data.members[1]))
          && request.resource.data.createdBy == callerEmail())
        ||
        (request.resource.data.type == 'grupo'
          && callerDoc().role in ['coordinador', 'rectora', 'superusuario']
          && request.resource.data.members.size() >= 2
          && callerEmail() in request.resource.data.members
          && request.resource.data.createdBy == callerEmail()
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0)
      );
      allow update: if isSuper()
        && request.resource.data.type == resource.data.type
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'allowedRoles']);
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if isActiveUser()
          && canAccessChannel(get(/databases/$(database)/documents/channels/$(channelId)).data);
        allow create: if isActiveUser()
          && canAccessChannel(get(/databases/$(database)/documents/channels/$(channelId)).data)
          && request.resource.data.keys().hasOnly(
               ['authorEmail', 'authorName', 'text', 'createdAt', 'deleted', 'adjunto'])
          && request.resource.data.authorEmail == callerEmail()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && (request.resource.data.text.size() > 0 || 'adjunto' in request.resource.data)
          && (!('adjunto' in request.resource.data) || adjuntoValido(request.resource.data.adjunto))
          && request.resource.data.createdAt == request.time
          && request.resource.data.deleted == false;
        allow update: if isActiveUser() && (
          (resource.data.authorEmail == callerEmail()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['text', 'editedAt', 'deleted']))
          ||
          (isSuper()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['deleted']))
        );
        allow delete: if false;
      }
    }

    match /auditLogs/{logId} {
      allow read: if isSuper();
      allow write: if false;
    }
    match /config/{docId} {
      allow read, write: if isSuper();
      allow delete: if false;
    }
    // =========================================================================
    //  BLOQUE DE REGLAS DEL MODULO DE ASISTENCIA
    //
    //  Integrado desde el repo de asistencia (rules/asistencia.rules). Se pega
    //  aqui porque Firestore admite un solo archivo de reglas por proyecto.
    //  ESTE archivo es el que se despliega: no editar el fragmento de alla y
    //  este a la vez, o divergen sin que nadie lo note.
    // =========================================================================

    // =============================================================================
    //  BLOQUE DE REGLAS DEL MODULO DE ASISTENCIA
    //  Entregable 2 de la seccion 7 del contrato de integracion.
    //
    //  Este archivo es un FRAGMENTO. No lleva `rules_version`, ni `service
    //  cloud.firestore`, ni el `match /databases/{database}/documents`, ni redefine los
    //  helpers de MJB (callerEmail, isInstitutional, callerDoc, isActiveUser, isSuper):
    //  se reusan los existentes.
    //
    //  Se pega dentro del `match /databases/{database}/documents` de mjb-prestamos, por
    //  convencion antes del `match /{document=**}` final. El orden no altera la
    //  evaluacion (las reglas se unen), pero mantiene el archivo legible.
    //
    //  Para probarlo, `tests/rules/rules.test.ts` lo compone con un stub de los helpers
    //  de MJB; ese stub NO se despliega.
    // =============================================================================

    // ---------- Helpers propios del modulo (nombres nuevos, no pisan los de MJB) ----------

    function asisIsCoordinador() {
      return isActiveUser() && callerDoc().role == 'coordinador';
    }

    // Coordinador ACOTADO POR SEDE. Julian decidio (2026-07-31) que Janneth manda en
    // Gustavo Rodas, Juan Diego en La Finquita, y ambos en central. Antes las reglas solo
    // miraban el rol, asi que cualquier coordinador leia la asistencia de cualquier sede.
    //
    // El documento espejo `asistenciaConfig/autoridadSede` guarda CORREOS, no slotId: en
    // las reglas la identidad garantizada es `callerEmail()`, mientras que `slotId` depende
    // de que el documento del usuario lo tenga bien puesto.
    //
    // Se declara aqui por si el fragmento se lee suelto; en el archivo fusionado de MJB ya
    // existe y NO debe declararse dos veces.
    function asisAutoridadDoc() {
      return get(/databases/$(database)/documents/asistenciaConfig/autoridadSede).data;
    }
    function asisAutoridadSede() {
      return asisAutoridadDoc().mapa;
    }
    function asisCoordinaSede(sede) {
      return asisIsCoordinador()
        && sede in asisAutoridadSede()
        && callerEmail() in asisAutoridadSede()[sede];
    }

    // Coordinador ACOTADO POR JORNADA — decision de Julian (2026-08-12).
    //
    // En la sede central hay DOS coordinadores, uno por jornada: a cada uno le corresponden
    // solo los grupos de la suya. En las otras sedes hay uno solo y manda en todo.
    //
    // Se modela como una RESTRICCION opcional y no como un permiso: el campo `soloJornada`
    // de `asistenciaConfig/autoridadSede` lista, por jornada, a los coordinadores limitados a
    // ella. Quien no aparezca ahi conserva la sede completa, asi que el documento actual
    // sigue siendo valido sin tocarlo y ningun coordinador pierde acceso por accidente.
    //
    //   autoridadSede = {
    //     mapa:        { central: [a@, b@], gustavo_rodas: [a@], la_finquita: [b@] },
    //     soloJornada: { central: { manana: [a@], tarde: [b@] } }        // opcional
    //   }
    //
    // ⚠️ LA RESTRICCION VA POR SEDE, no por persona. Es "en central y SOLO en central", y el
    // dato real lo demuestra: la misma coordinadora que solo lleva la manana de central
    // coordina Gustavo Rodas ENTERA, que tiene siete grupos de tarde. Una restriccion global
    // por persona le habria borrado esos siete sin que nadie entendiera por que.
    //
    // Se listan por JORNADA y no `correo -> jornada` a proposito: un correo como clave de
    // mapa lleva puntos, que es justo lo que obligo a anidar el mapa de directores bajo
    // `mapa`. Con listas por jornada no hay claves con puntos en ninguna parte.
    function asisOtraJornada(jornada) {
      return jornada == 'manana' ? 'tarde' : 'manana';
    }
    function asisLimitadoAOtraJornada(sede, jornada) {
      return 'soloJornada' in asisAutoridadDoc()
        && sede in asisAutoridadDoc().soloJornada
        && asisOtraJornada(jornada) in asisAutoridadDoc().soloJornada[sede]
        && callerEmail() in asisAutoridadDoc().soloJornada[sede][asisOtraJornada(jornada)];
    }
    function asisCoordinaJornada(sede, jornada) {
      return asisCoordinaSede(sede) && !asisLimitadoAOtraJornada(sede, jornada);
    }

    // Consulta ampliada: cargos de apoyo sin grupo (PTA, apoyo) que LEEN todas las planillas
    // y no escriben NADA. Decision de Julian (2026-08-12): "solo de consulta, no pueden
    // modificar ni llamar a editar; esa es tarea de los coordinadores".
    //
    // Va como BANDERA EN `users/{correo}`, no como documento espejo aparte, y la razon es de
    // seguridad, no de comodidad:
    //
    //   La restriccion tiene que entrar tambien en `asisCanRecord()`, que se evalua en CADA
    //   marca de asistencia del colegio. Si eso dependiera de un `get()` a otro documento, el
    //   dia que ese documento faltara o se borrara el `get()` reventaria — y un error en una
    //   regla es una DENEGACION. Nadie podria pasar lista en todo el colegio por un documento
    //   de configuracion ausente.
    //
    //   `callerDoc()` en cambio ya se lee para comprobar el rol, asi que la bandera no cuesta
    //   ninguna lectura extra, y un campo ausente es simplemente `!= true`. No hay forma de
    //   que su ausencia rompa nada.
    //
    // Se activa poniendo `asistenciaConsulta: true` en `users/{correo}`.
    function asisConsultaAmpliada() {
      // `get(campo, por_defecto)` obligatorio: casi ninguna cuenta tiene el campo, y leerlo
      // directo revienta la regla en vez de dar falso. Ver la nota en `asisCanRecord`.
      return isActiveUser() && callerDoc().get('asistenciaConsulta', false) == true;
    }

    function asisIsRectora() {
      return isActiveUser() && callerDoc().role == 'rectora';
    }

    // Quien puede REGISTRAR. Se excluye a dos roles, por razones distintas:
    //  - superusuario: su clave es transferible, asi que sus actos no serian atribuibles
    //    a una persona fisica.
    //  - rectora: decision de Julian (2026-07-30). Consulta, no registra.
    //
    // OJO: antes de este cambio la rectora SI podia registrar. El filtro solo excluia al
    // superusuario, y como 'rectora' es un rol distinto, pasaba. No era una decision:
    // era un hueco.
    function asisCanRecord() {
      return isActiveUser()
        && callerDoc().role != 'superusuario'
        && callerDoc().role != 'rectora'
        // Cargos de apoyo (PTA, apoyo): su rol es `docente` porque el esquema no tiene uno
        // propio, asi que sin esta linea pasaban por aqui como cualquier docente y podian
        // marcar asistencia. Lo detecto una prueba de reglas el 2026-08-12, no el codigo:
        // el comentario de arriba decia "solo de consulta" y la regla no lo cumplia.
        //
        // ⚠️ `get(campo, valorPorDefecto)` y NO `callerDoc().asistenciaConsulta`: leer un
        // campo AUSENTE en las reglas de Firestore no devuelve falso, REVIENTA la evaluacion,
        // y un error es una denegacion. Como ninguna cuenta tiene hoy ese campo, la forma
        // directa dejaba al colegio entero sin poder pasar lista. Es la misma trampa por la
        // que el blindaje de `docNumber` usa `affectedKeys()` en vez de comparar el campo.
        && callerDoc().get('asistenciaConsulta', false) != true;
    }

    // Director de grupo: no es un valor de `role`. Se resuelve contra un unico documento
    // espejo, `asistenciaConfig/directores`, cuyo campo `mapa` va de grado a slotId.
    // El mapa va anidado bajo `mapa` a proposito: como campo de raiz, un grado de la
    // manana como "9.1" seria ambiguo con la notacion de rutas de campo de Firestore, que
    // usa el punto como separador. Por eso tambien se escribe con setDoc, nunca updateDoc.
    // Se compara contra slotId y no contra el correo: el mapa apunta al PUESTO, asi que
    // sigue siendo correcto despues de reemplazar a un docente.
    function asisDirectores() {
      return get(/databases/$(database)/documents/asistenciaConfig/directores).data.mapa;
    }
    function asisIsDirectorOf(grado) {
      return isActiveUser()
        && grado in asisDirectores()
        && asisDirectores()[grado] == callerDoc().slotId;
    }

    // Sello de autoria a nivel de documento. Es lo unico que el servidor puede garantizar
    // cuando una misma escritura toca varios estudiantes del mapa (las reglas no iteran).
    function asisAuthorStamp() {
      return request.resource.data.ultimaEscrituraPor == callerEmail()
        && request.resource.data.ultimaEscrituraEn == request.time;
    }

    // ---------- Sesiones de clase: el documento central ----------
    match /asistenciaSessions/{sessionId} {

      // Un docente NO puede leer las sesiones de estudiantes que no son suyos. La version
      // original dejaba el filtrado a la interfaz, pero una interfaz no protege nada: basta
      // pedir el documento directamente. Como los motivos de justificacion pueden incluir
      // informacion de salud de menores, la restriccion tiene que estar en el servidor.
      //   coordinador       -> solo las sedes que le tocan (autoridadSede)
      //   director de grupo -> las de su grado, en cualquier asignatura, la dicte o no
      //   docente           -> solo las que el mismo dicta (por slotId)
      //   superusuario      -> ninguna (misma razon por la que no registra)
      //
      // OJO EN EL CLIENTE: Firestore rechaza la consulta entera si no puede probar que
      // todos los resultados seran legibles. Un docente DEBE consultar con
      // where('slotId','==',<el suyo>) y un director con where('grado','==',<el suyo>);
      // una consulta sin filtrar falla aunque tuviera derecho a cada documento.
      allow read: if isActiveUser() && (
        // Coordinador: su sede, y en central solo su jornada (ver asisCoordinaJornada).
        asisCoordinaJornada(resource.data.sede, resource.data.jornada)
        || asisIsRectora()                     // consulta institucional; no registra
        || asisIsDirectorOf(resource.data.grado)
        || resource.data.slotId == callerDoc().slotId
        // AL FINAL a proposito: ver la nota de asisConsultaAmpliada sobre el documento que
        // debe existir. Los casos anteriores resuelven antes y ni llegan aqui.
        || asisConsultaAmpliada()
      );

      // Decision (a) del contrato: cualquier docente activo puede abrir una sesion. El
      // horario propone, no prohibe — los reemplazos improvisados son el dia a dia, y una
      // sesion bloqueada es una sesion que no existe para la estadistica.
      allow create: if asisCanRecord()
        && request.resource.data.createdBy == callerEmail()
        && request.resource.data.createdAt == request.time
        && request.resource.data.closed == false
        && request.resource.data.grado is string
        && request.resource.data.fecha is string
        && request.resource.data.bloque is int
        && request.resource.data.bloque >= 1
        && request.resource.data.bloque <= 6
        && request.resource.data.sede in ['central', 'gustavo_rodas', 'la_finquita']
        && request.resource.data.jornada in ['manana', 'tarde']
        && asisAuthorStamp();

      // Actualizacion: o se marcan estudiantes, o se cierra la sesion. Nunca se puede
      // reescribir la identidad de la sesion ni quien la creo.
      allow update: if asisCanRecord()
        && asisAuthorStamp()
        && request.resource.data.grado == resource.data.grado
        && request.resource.data.fecha == resource.data.fecha
        && request.resource.data.bloque == resource.data.bloque
        && request.resource.data.subjectId == resource.data.subjectId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estudiantes', 'closed', 'closedBy', 'closedAt',
                       'ultimaEscrituraPor', 'ultimaEscrituraEn'])
        // Si se cierra la sesion, queda dicho quien la cerro.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['closed'])
            || request.resource.data.closedBy == callerEmail());

      allow delete: if false;   // no se borra: se corrige, y la correccion deja rastro

      // El historial lo escribe una Cloud Function con Admin SDK. Jamas el cliente: si
      // dependiera del cliente, una correccion sin rastro seria trivial, y el rastro es
      // justo lo que protege ante una disputa de una familia.
      match /historial/{entryId} {
        // Estaba como `... || isActiveUser()`, que en la practica lo abria a todo el mundo
        // y volvia decorativas las dos primeras condiciones. El historial de correcciones
        // es material de coordinacion, no de consulta general.
        allow read: if isSuper() || asisIsCoordinador();
        allow write: if false;
      }
    }

    // ---------- Llegadas tarde a la institucion ----------
    // OJO: no es el `retraso` de clase. Otra autoridad y otra unidad temporal.
    match /asistenciaLateArrivals/{lateId} {

      allow read: if isSuper()
        || asisCoordinaSede(resource.data.sede)
        || asisIsRectora()
        || asisIsDirectorOf(resource.data.grado);

      // Autoridad exclusiva del coordinador. Un director de grupo las VE pero no las crea.
      allow create: if asisCoordinaSede(request.resource.data.sede)
        && request.resource.data.registradoPor == callerEmail()
        && request.resource.data.registradoEn == request.time
        && request.resource.data.studentId is string
        && request.resource.data.grado is string
        && request.resource.data.fecha is string
        && request.resource.data.bloqueIngreso is int
        && request.resource.data.estado in ['sin_justificar', 'pendiente_verificacion', 'justificada'];

      // La verificacion posterior (llamar al acudiente y cerrar el estado) es del
      // coordinador. La autoria original es inmutable.
      allow update: if asisCoordinaSede(resource.data.sede)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.fecha == resource.data.fecha
        && request.resource.data.registradoPor == resource.data.registradoPor
        && request.resource.data.registradoEn == resource.data.registradoEn
        && request.resource.data.estado in ['sin_justificar', 'pendiente_verificacion', 'justificada']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'motivo', 'observacion', 'horaLlegada', 'bloqueIngreso',
                       'resueltoPor', 'resueltoEn'])
        && request.resource.data.resueltoPor == callerEmail();

      allow delete: if false;

      match /historial/{entryId} {
        allow read: if isSuper() || asisIsCoordinador();
        allow write: if false;
      }
    }

    // ---------- Contactos con la familia (llamadas y avisos, un solo historial) ----------
    match /asistenciaFamilyContacts/{contactId} {

      // Las observaciones de las llamadas son solo para coordinacion y direccion de grupo.
      allow read: if isSuper()
        || asisCoordinaSede(resource.data.sede)
        || asisIsDirectorOf(resource.data.grado);

      allow create: if (asisCoordinaSede(request.resource.data.sede) || asisIsDirectorOf(request.resource.data.grado))
        && request.resource.data.llamadoPor == callerEmail()
        && request.resource.data.llamadoEn == request.time
        && request.resource.data.resultado in ['contesto', 'no_contesto', 'pendiente'];

      allow update: if (asisCoordinaSede(resource.data.sede) || asisIsDirectorOf(resource.data.grado))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['resultado', 'observacion'])
        && request.resource.data.resultado in ['contesto', 'no_contesto', 'pendiente'];

      allow delete: if false;
    }

    // ---------- Fichas de estudiantes ----------
    match /asistenciaStudents/{studentId} {
      allow read: if isActiveUser();

      // La creacion masiva la hace la Cloud Function de importacion (Admin SDK).
      allow create: if isSuper();

      // Edita el superusuario, el coordinador o el director del grupo del estudiante.
      // Campos blindados: el hash del documento, el token QR y el grado vigente. Si un
      // director pudiera reescribir `gradoActual`, se auto-otorgaria permiso sobre
      // cualquier ficha del colegio.
      allow update: if (isSuper() || asisCoordinaSede(resource.data.sede) || asisIsDirectorOf(resource.data.gradoActual))
        && request.resource.data.docHash == resource.data.docHash
        && request.resource.data.qrToken == resource.data.qrToken
        && request.resource.data.gradoActual == resource.data.gradoActual
        // El numero de documento lo escribe UNICAMENTE la Cloud Function de importacion,
        // que lo guarda junto al hash que sale de el. Si un cliente pudiera corregirlo, el
        // numero y el hash dejarian de corresponder y la siguiente importacion veria a ese
        // estudiante como una persona nueva.
        //
        // Se compara con affectedKeys y no con igualdad directa porque las fichas
        // importadas antes de que el campo existiera NO lo tienen: `resource.data.docNumber`
        // reventaria la evaluacion en esos documentos.
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['docNumber']);

      allow delete: if false;   // baja logica con activo:false

      match /historial/{entryId} {
        allow read: if isSuper() || asisIsCoordinador();
        allow write: if false;
      }
    }

    // ---------- Matriculas (grado con vigencia) ----------
    match /asistenciaEnrollments/{enrollmentId} {
      allow read: if isActiveUser();

      // Acotado por sede igual que el resto. Se decidio NO cerrarlo por grado: el grado
      // identifica la sede solo por una convencion implicita (Gustavo Rodas usa 1 y 2 en el
      // ultimo digito, La Finquita el 3) que se rompe el dia que se abra un tercer grupo.
      // La redundancia del campo es lo que hace la regla demostrable.
      allow create: if isSuper()
        || (asisCoordinaSede(request.resource.data.sede)
            && request.resource.data.sede in ['central', 'gustavo_rodas', 'la_finquita']);

      allow update: if isSuper()
        || (asisCoordinaSede(resource.data.sede)
            && request.resource.data.sede == resource.data.sede);

      allow delete: if false;
    }

    // ---------- Datos base: los carga el superusuario ----------
    match /asistenciaPeriods/{periodId} {
      allow read: if isActiveUser();
      allow create, update: if isSuper();
      allow delete: if false;
    }

    // Catalogo de las siete marcas. Se desactivan, nunca se borran: el historico ya
    // registrado apunta a ellas.
    match /asistenciaCatalog/{code} {
      allow read: if isActiveUser();
      allow create, update: if isSuper();
      allow delete: if false;
    }

    // La eleccion Master2000 vs. app, por asignatura y periodo.
    match /asistenciaSubjectConfigs/{configId} {
      allow read: if isActiveUser();
      allow create, update: if asisCanRecord()
        && request.resource.data.fuente in ['app', 'master2000']
        && request.resource.data.fijadoPor == callerEmail();
      allow delete: if false;
    }

    // Umbrales de alerta. Cada docente puede ajustar el suyo de retrasos; el resto de la
    // configuracion es del superusuario.
    match /asistenciaConfig/{docId} {
      allow read: if isActiveUser();
      allow write: if isSuper()
        || (docId == 'alertas' && asisIsCoordinador())
        || (docId == 'umbralesPorDocente' && asisCanRecord());
    }

    // ---------- Eventos: grupos temporales ----------
    //
    // Una feria, un centro de interes, una salida: un conjunto de estudiantes que NO es un
    // curso, con su propia planilla por fecha. Existe para no tener que construir un modulo
    // nuevo por cada actividad especial del colegio.
    //
    // La autoridad aqui NO se parece a la del resto del modulo, y es a proposito (requisito
    // de Julian, 2026-08-11): un evento lo ve y lo registra UNICAMENTE la lista de docentes
    // con quienes se compartio. Ni el coordinador ni la rectora ni el superusuario entran,
    // aunque en las sesiones de clase si lo hagan.
    //
    // ⚠️ CONSECUENCIA QUE HAY QUE CONFIRMAR CON JULIAN: nadie de coordinacion puede auditar
    // lo que se registra en un evento. Para asistencia de clase eso seria inaceptable —son
    // datos de menores—, pero un evento es una lista de participacion, no el registro
    // oficial. Si algun dia se decide que coordinacion debe poder consultar, se anade
    // `|| asisCoordinaSede(resource.data.sede)` a la lectura y nada mas.
    //
    // El evento es la unica fuente de verdad de quien puede entrar. La lista NO se copia a
    // las sesiones: si se copiara, compartir el evento obligaria a reescribir todas las
    // sesiones ya existentes, y un fallo a mitad de camino dejaria a alguien con acceso a
    // unas fechas y no a otras.
    function asisEventoDe(eventId) {
      return get(/databases/$(database)/documents/asistenciaEvents/$(eventId)).data;
    }
    function asisEnEvento(eventId) {
      return isActiveUser() && callerEmail() in asisEventoDe(eventId).docentes;
    }

    match /asistenciaEvents/{eventId} {

      // OJO EN EL CLIENTE: la consulta DEBE ir con
      // where('docentes','array-contains', <su correo>). Firestore rechaza la consulta
      // entera si no puede probar de antemano que todo el resultado sera legible; sin ese
      // filtro falla con permission-denied aunque tuviera derecho a cada documento.
      allow read: if isActiveUser() && callerEmail() in resource.data.docentes;

      // Cualquier docente que pueda registrar puede crear un evento (requisito explicito:
      // no se limita al superusuario ni a coordinacion). Quedan fuera el superusuario y la
      // rectora, por las mismas razones que en las sesiones de clase.
      //
      // Se exige que el creador quede dentro de `docentes` para que no pueda fabricar un
      // evento al que el mismo no tenga acceso — un documento invisible para todos, que
      // nadie podria corregir ni dar de baja despues.
      allow create: if asisCanRecord()
        && request.resource.data.creadoPor == callerEmail()
        && callerEmail() in request.resource.data.docentes
        && request.resource.data.sede in ['central', 'gustavo_rodas', 'la_finquita']
        && request.resource.data.desde <= request.resource.data.hasta;

      // Editar el evento: cualquiera de sus docentes. Con dos candados:
      //
      //  1. La autoria original es inmutable. Documenta un hecho ocurrido.
      //  2. La lista de docentes SOLO la cambia el creador, y no puede sacarse a si mismo.
      //     Sin esto, alguien con quien se compartio el evento podria expulsar al resto y
      //     quedarse con el — incluido el creador, que perderia el acceso a algo suyo.
      allow update: if isActiveUser()
        && callerEmail() in resource.data.docentes
        && request.resource.data.creadoPor == resource.data.creadoPor
        && resource.data.creadoPor in request.resource.data.docentes
        && (
          callerEmail() == resource.data.creadoPor
          || request.resource.data.docentes == resource.data.docentes
        );

      allow delete: if false;   // baja logica con activo:false, como en todo el modulo

      // Las sesiones van como SUBCOLECCION, no sueltas. La razon es de demostrabilidad:
      // aqui el `eventId` viene en la RUTA, asi que la regla puede ir a buscar la lista de
      // docentes al documento padre sin mirar ningun campo del propio documento. Eso hace
      // que la consulta sea demostrable sin filtros extra y sin indice compuesto.
      //
      // Sueltas en una coleccion propia, la regla tendria que leer `resource.data.eventId`,
      // y entonces Firestore exigiria que la consulta filtrara por ese campo... y aun asi no
      // podria resolver el get() del padre. Habria obligado a duplicar la lista de docentes
      // en cada sesion.
      match /sesiones/{fecha} {
        allow read: if asisEnEvento(eventId);

        // Se escribe con rutas de campo puntuales (`estudiantes.est_0412.estado`), igual que
        // las sesiones de clase: varios docentes comparten el evento y pueden estar marcando
        // a la vez. Reemplazar el mapa completo borraria el trabajo del otro.
        allow create, update: if asisEnEvento(eventId)
          && asisCanRecord()
          && asisAuthorStamp();

        allow delete: if false;
      }
    }

    // ---------- Direccion de grupo: el cuaderno del director ----------
    //
    // Columnas que define el director (cuotas, equipos de aseo, requisitos). NO es asistencia
    // y no se cruza con ella.
    //
    // AUTORIDAD: SOLO el director del grupo. Decision expresa de Julian (2026-08-12): esto es
    // interno del grupo. Ni coordinacion, ni rectora, ni superusuario.
    //
    // ⚠️ CONSECUENCIA ACEPTADA: si el director se ausenta, NADIE puede consultar su cuaderno
    // —quien pago la cuota, quien cumplio el requisito—. Se le advirtio y lo decidio asi. Para
    // abrirlo a coordinacion bastaria anadir `|| asisCoordinaSede(...)` a la lectura, pero eso
    // exigiria denormalizar la sede aqui, porque el grado no la determina.
    //
    // El año va como SUBCOLECCION y no como campo: asi el `{grado}` viene en la RUTA y la
    // regla lo resuelve sin mirar campos del documento — demostrable sin filtros ni indice,
    // el mismo motivo que en las sesiones de un evento.
    match /asistenciaDireccionGrupo/{grado}/anios/{anio} {
      allow read: if asisIsDirectorOf(grado);

      // `asisCanRecord()` ademas del director: la rectora no escribe en ningun sitio, y el
      // superusuario tampoco (su clave es transferible).
      //
      // ⚠️ ESTA REGLA NO PUEDE IMPEDIR QUE EL CLIENTE VACIE EL CUADERNO, y conviene saberlo
      // antes de confiarse. En `asistenciaSessions` un `setDoc` sobre una sesion viva rebota
      // porque la identidad de la sesion es inmutable; aqui no hay identidad que proteger, y
      // para las reglas un `updateDoc` legitimo y un `setDoc` que arrasa producen el MISMO
      // `request.resource.data`. Son indistinguibles.
      //
      // Por eso `abrirDireccionGrupo` LEE antes de escribir. El 2026-08-12 no lo hacia, y
      // borraba las columnas del director cada vez que abria la pantalla.
      allow create, update: if asisIsDirectorOf(grado)
        && asisCanRecord()
        && asisAuthorStamp()
        // Lo unico que si se puede blindar: el cuaderno no cambia de dueño ni de año.
        && request.resource.data.grado == grado
        && request.resource.data.anio == int(anio);

      // Se borran COLUMNAS desde la aplicacion (quitandolas del arreglo), nunca el cuaderno
      // entero de un manotazo.
      allow delete: if false;
    }

    // ---------- Tokens QR ----------
    // El token es la unica carga util del QR: una cadena opaca sin datos personales.
    match /asistenciaQrTokens/{token} {
      allow read: if isActiveUser();     // hay que poder resolver un escaneo, incluso offline
      allow write: if false;             // los genera y rota una Cloud Function
    }

    // ---------- Revision manual de importacion ----------
    match /asistenciaImportReviews/{reviewId} {
      allow read: if isSuper();
      allow write: if false;
    }

    // ---------- Programas: centros de interes y todo lo que se reparte por semestre ----------
    //
    // Contrato: `docs/modelo-centros-interes.md` (2026-08-24). Si algo de aqui choca con el,
    // gana el contrato.
    //
    // POR QUE NO SON EVENTOS. Un evento es puntual y su autoridad es la lista `docentes` del
    // propio documento. Un centro de interes dura un semestre y se agrupa con otros veinte
    // bajo UNA coordinacion, que manda sobre todos sin que haya que agregarla a cada uno.
    // Meter a la coordinadora en los `docentes` de cada centro es mas barato y es fragil por
    // diseno: el dia que alguien cree un centro y no la agregue, ella deja de verlo y nadie
    // se entera. Por eso la autoridad cuelga del PROGRAMA, que esta en la RUTA.
    //
    // LO QUE ESTAS REGLAS NO PUEDEN HACER: `exclusivo` (un estudiante, un solo centro) es una
    // restriccion de unicidad ENTRE documentos. Verificarla exigiria leer los 21 grupos y
    // reventaria el tope de get(). Va como validacion del cliente + revision de la
    // coordinadora, y los choques quedan como pendientes de tipo `duplicado`. Se escribe aqui
    // para que nadie la busque en las reglas y concluya que falta.

    function asisProgramaDe(programaId) {
      return get(/databases/$(database)/documents/asistenciaProgramas/$(programaId)).data;
    }

    // QUIEN PUEDE CREAR UN PROGRAMA NUEVO, ademas del superusuario y la coordinacion de
    // sede. Requisito explicito de Julian (2026-08-25): la lider del proyecto de centros
    // de interes tiene rol de docente y `asistenciaConsulta`, y aun asi debe poder crear
    // el programa del semestre siguiente sin depender de la cuenta de administracion.
    //
    // NO se resuelve con "quien ya coordina algun programa": eso obligaria a recorrer
    // todos los programas y no es demostrable en una regla. Se resuelve con una lista
    // explicita en `asistenciaConfig/programas`, que solo escribe el superusuario.
    //
    // `exists()` antes del `get()`, y `get('creadores', [])` y no `.creadores`: hoy ese
    // documento NO existe todavia, y si existiera sin el campo, acceder directo LANZARIA
    // error — y un error en una regla es una denegacion. Es la misma trampa que tumbo la
    // asistencia de todo el colegio con `asistenciaConsulta`.
    function asisCreadoresDePrograma() {
      return exists(/databases/$(database)/documents/asistenciaConfig/programas)
        ? get(/databases/$(database)/documents/asistenciaConfig/programas).data.get('creadores', [])
        : [];
    }

    // COORDINADOR DE PROGRAMA: quien esta en `coordinadores` del documento del programa.
    // Manda sobre TODOS sus grupos, sesiones y pendientes.
    //
    // /!\ ESTO NO PASA POR `asisCanRecord()`, Y ES CONTRAINTUITIVO A PROPOSITO.
    // Yuri coordina los centros de interes y tiene `asistenciaConsulta: true` (no registra
    // asistencia de clase en ningun lado). Si coordinar dependiera de `asisCanRecord()`, la
    // bandera que le impide marcar una clase le impediria tambien crear grupos, inscribir
    // estudiantes y resolver pendientes -- que es justo su trabajo. La regla es:
    //     coordinar el programa  -> NO pasa por asisCanRecord()
    //     ESCRIBIR una sesion    -> SI pasa por asisCanRecord()
    // Quien no puede registrar (superusuario, rectora, `asistenciaConsulta:true`) tampoco
    // escribe sesiones aqui, ni siquiera coordinando. Ver el match de /sesiones.
    //
    // `get('coordinadores', [])` y no acceso directo: un campo AUSENTE no devuelve falso,
    // REVIENTA la evaluacion, y un error en una regla es una denegacion. Es la trampa que ya
    // dejo al colegio entero sin pasar lista con `callerDoc().asistenciaConsulta != true`.
    function asisCoordinaPrograma(programaId) {
      return isActiveUser()
        && callerEmail() in asisProgramaDe(programaId).get('coordinadores', []);
    }

    // Lider/docente de un grupo concreto. El grupoId viene en la RUTA, asi que se resuelve
    // sin mirar ningun campo del documento hijo (ver la nota de demostrabilidad mas abajo).
    function asisGrupoProgramaDe(programaId, grupoId) {
      return get(/databases/$(database)/documents/asistenciaProgramas/$(programaId)/grupos/$(grupoId)).data;
    }
    function asisEnGrupoPrograma(programaId, grupoId) {
      return isActiveUser()
        && callerEmail() in asisGrupoProgramaDe(programaId, grupoId).get('docentes', []);
    }

    match /asistenciaProgramas/{programaId} {

      // El documento del programa es la cabecera (nombre, fechas, sede, coordinadores): no
      // lleva datos de menores. Cualquier usuario activo lo lee, porque el lider de un centro
      // necesita saber las fechas del semestre y la lectura tiene que ser demostrable sin
      // filtros. Los datos sensibles viven en grupos/sesiones/pendientes, que si estan
      // cerrados.
      allow read: if isActiveUser();

      // Crear un programa es un acto de coordinacion de sede (o del superusuario en la carga
      // inicial). Se exige que quien lo crea quede DENTRO de `coordinadores`, por la misma
      // razon que en los eventos: para que no pueda fabricar un programa que nadie -- ni el
      // mismo -- pueda coordinar despues.
      // Tres puertas, no dos: superusuario, coordinacion de la sede, y quien este en la
      // lista de `asistenciaConfig/programas` (ver `asisCreadoresDePrograma`). La tercera
      // es la que le permite a la lider del proyecto arrancar el semestre siguiente.
      allow create: if (
          isSuper()
          || asisCoordinaSede(request.resource.data.sede)
          || callerEmail() in asisCreadoresDePrograma()
        )
        && request.resource.data.creadoPor == callerEmail()
        && callerEmail() in request.resource.data.coordinadores
        && request.resource.data.tipo is string
        && request.resource.data.sede in ['central', 'gustavo_rodas', 'la_finquita']
        && request.resource.data.desde <= request.resource.data.hasta
        && request.resource.data.exclusivo is bool
        && request.resource.data.activo is bool;

      // Aqui se lee `resource.data.coordinadores` en vez de llamar a asisCoordinaPrograma():
      // el documento del programa ES este documento, asi que el get() sobraria. Un get()
      // menos en la cuenta del tope de 10.
      //
      // La autoria (`creadoPor`) es inmutable, igual que en asistenciaEvents: documenta un
      // hecho ocurrido.
      //
      // NO se exige que el creador siga en `coordinadores` (eso si se hace en los eventos):
      // aqui el programa lo suele crear el superusuario en la carga inicial y entregarselo a
      // la coordinadora, asi que atarlo al creador dejaria a un administrador dentro para
      // siempre. Lo que si se blinda es que la lista no quede VACIA: un programa sin
      // coordinacion es un programa que nadie puede volver a tocar — ni sus grupos, ni sus
      // pendientes — porque toda la autoridad de las subcolecciones cuelga de esta lista.
      allow update: if isActiveUser()
        && (isSuper() || (callerEmail() in resource.data.get('coordinadores', [])))
        && request.resource.data.creadoPor == resource.data.creadoPor
        && request.resource.data.sede == resource.data.sede
        && request.resource.data.coordinadores.size() > 0;

      allow delete: if false;   // baja logica con activo:false, como en todo el modulo

      // ---------- Los centros de interes concretos ----------
      //
      // Van como SUBCOLECCION y no sueltos por el mismo motivo que las sesiones de un evento:
      // el `programaId` queda en la RUTA, asi que la regla va a buscar `coordinadores` al
      // documento padre sin mirar ningun campo del hijo. Sueltos, la regla tendria que leer
      // `resource.data.programaId`, Firestore exigiria filtrar por ese campo en cada consulta
      // y aun asi no podria resolver el get() del padre.
      match /grupos/{grupoId} {

        // /!\ LA FORMA DE ESTA LECTURA ES DELIBERADA, NO ESTILISTICA.
        //
        // La primera rama NO mira `resource`: solo la ruta y el documento padre. Por eso la
        // consulta SIN filtro de la coordinadora es DEMOSTRABLE -- Firestore puede probar de
        // antemano que todo resultado posible le sera legible, y le devuelve los 21 centros
        // de un tiron.
        //
        // La segunda SI mira `resource`, asi que el docente DEBE consultar con
        // where('docentes','array-contains', <su correo>). Sin ese filtro Firestore rechaza
        // la CONSULTA ENTERA con permission-denied, aunque tuviera derecho a cada documento
        // uno por uno.
        //
        // Coste en get(): coordinadora = users + programa (2 documentos). Docente = users y
        // nada mas, porque el grupo ya viene resuelto en `resource`. Lejos del tope de 10.
        allow read: if asisCoordinaPrograma(programaId)
                 || (isActiveUser() && callerEmail() in resource.data.docentes);

        // Crear el centro, editarlo, inscribir y mover estudiantes: SOLO la coordinacion del
        // programa. No pasa por asisCanRecord() (ver la nota de asisCoordinaPrograma: Yuri).
        //
        // Se exige que el lider este tambien en `docentes` para que el grupo no nazca con un
        // responsable que no puede ni verlo.
        allow create: if asisCoordinaPrograma(programaId)
          && request.resource.data.creadoPor == callerEmail()
          && request.resource.data.lider in request.resource.data.docentes
          && request.resource.data.miembros is list
          && request.resource.data.activo is bool;

        // El lider/docente NO edita el grupo: ni `miembros`, ni `docentes`, ni nada. Su
        // autoridad llega hasta las sesiones. Un centro se inscribe y se rebaraja desde
        // coordinacion, que es quien ve los 21 a la vez y por tanto la unica que puede
        // detectar que un estudiante quedo en dos (`exclusivo`).
        allow update: if asisCoordinaPrograma(programaId)
          && request.resource.data.creadoPor == resource.data.creadoPor
          && request.resource.data.lider in request.resource.data.docentes;

        allow delete: if false;   // baja logica con activo:false

        // ---------- La planilla de cada fecha ----------
        // Identica en forma a la sesion de un evento y calculada con las MISMAS funciones de
        // domain/eventos.ts. Se escribe con rutas de campo puntuales
        // (`estudiantes.est_0412.estado`) para no perder el conflicto por estudiante.
        match /sesiones/{fecha} {

          // Coste en get(): docente = users + grupo (2 documentos; el programa ni se toca,
          // por cortocircuito del ||). Coordinadora = users + grupo + programa (3).
          // Tope de Firestore: 10 por evaluacion de documento unico o de consulta. Sobra
          // margen -- pero se cuenta a mano y se deja escrito porque EL EMULADOR NO APLICA
          // ESTE LIMITE: pasar en local no prueba nada sobre produccion.
          allow read: if asisEnGrupoPrograma(programaId, grupoId)
                   || asisCoordinaPrograma(programaId);

          // /!\ AQUI SI ENTRA asisCanRecord(), y va PRIMERO a proposito.
          // Es la unica puerta del programa que lo exige: escribir una sesion es registrar
          // asistencia, y quien no registra en el resto del modulo (superusuario, rectora,
          // `asistenciaConsulta:true`) tampoco registra aqui -- ni coordinando el programa.
          // Se reutiliza la funcion, no se reescribe la condicion: el dia que se excluya a un
          // rol mas, este match tiene que enterarse solo.
          allow create, update: if asisCanRecord()
            && (asisEnGrupoPrograma(programaId, grupoId) || asisCoordinaPrograma(programaId))
            && asisAuthorStamp();

          allow delete: if false;
        }
      }

      // ---------- La bandeja de revision ----------
      //
      // Lo que la coordinadora resuelve a un clic en vez de recibir en una lista de papel.
      // Es EXCLUSIVA de la coordinacion del programa: un lider no ve los pendientes, porque
      // cada uno lleva nombres de estudiantes de TODO el colegio como candidatos.
      //
      // Tampoco pasa por asisCanRecord(): resolver un homonimo no es marcar asistencia.
      match /pendientes/{pendienteId} {
        allow read: if asisCoordinaPrograma(programaId);

        allow create: if asisCoordinaPrograma(programaId)
          && request.resource.data.tipo in ['homonimo', 'no_encontrado', 'ortografia', 'duplicado']
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.candidatos is list;

        // Resolver: la evidencia del archivo es inmutable (`tipo`, `nombreArchivo`,
        // `grupoArchivo`), porque es lo que permite auditar la decision despues. Y quien
        // resuelve firma con su propio correo.
        //
        // `get('resueltoPor', '')` sobre request.resource: mientras el pendiente sigue en
        // `pendiente` el campo NO existe, y leerlo directo reventaria la evaluacion.
        allow update: if asisCoordinaPrograma(programaId)
          && request.resource.data.tipo == resource.data.tipo
          && request.resource.data.nombreArchivo == resource.data.nombreArchivo
          && request.resource.data.grupoArchivo == resource.data.grupoArchivo
          && request.resource.data.estado in ['pendiente', 'resuelto', 'descartado']
          && (request.resource.data.estado == 'pendiente'
              || request.resource.data.get('resueltoPor', '') == callerEmail());

        allow delete: if false;   // un pendiente se descarta (estado), no se borra: es rastro
      }
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
