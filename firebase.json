{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": [
    { "bucket": "mjb-prestamos.firebasestorage.app", "rules": "storage.rules" },
    { "bucket": "mjb-prestamos-chat", "rules": "storage.rules" }
  ],
  "functions": [
    { "source": "functions", "codebase": "default", "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"] },
    { "source": "functions-asistencia", "codebase": "asistencia", "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"] },
    { "source": "functions-calendario", "codebase": "calendario", "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"] }
  ],
  "hosting": {
    "public": "src/asistencia/publico",
    "ignore": ["**/.*"],
    "headers": [{ "source": "**", "headers": [
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Robots-Tag", "value": "noindex" },
      { "key": "Cache-Control", "value": "no-cache" } ] }]
  },
  "emulators": { "firestore": { "port": 8080 }, "singleProjectMode": true }
}
