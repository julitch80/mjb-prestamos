// ⛔ ARCHIVO COMPARTIDO — proyecto Firebase 'mjb-prestamos'
//
// Este proyecto aloja DOS modulos: prestamos (este repo) y asistencia (repo
// aparte). Cloud Storage admite UN SOLO archivo de reglas por proyecto: el
// ultimo despliegue REEMPLAZA todo lo anterior, no lo fusiona.
//
// Por eso:
//   - NO despliegues estas reglas desde el repo de asistencia, ni las de
//     asistencia desde aqui. Quien lo haga deja al otro modulo sin permisos.
//   - Cualquier ruta nueva debe agregarse a ESTE archivo unificado antes de
//     desplegar. La regla catch-all del final niega todo lo no declarado.
//   - Despliegue: `firebase deploy --only storage`.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Comprobación de dominio institucional. Storage rules NO pueden hacer
    // get() a Firestore de forma barata (no hay `get()` de documentos como en
    // firestore.rules), así que aquí NO se puede verificar la pertenencia al
    // canal (`members` del documento `channels/{channelId}`) ni el estado
    // `active` del usuario. La URL de descarga con token que genera Firebase
    // Storage es la que realmente protege el acceso a cada archivo: solo
    // quien la recibe (por estar en el chat) puede abrirla directamente.
    function isInstitutional() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@iemanueljbetancur[.]edu[.]co');
    }

    function contentTypeValido() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'audio/mpeg'
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        || request.resource.contentType == 'application/vnd.ms-excel'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        || request.resource.contentType == 'application/vnd.ms-powerpoint'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        || request.resource.contentType == 'text/plain';
    }

    // Adjuntos del chat interno: chat/{channelId}/{fileName}.
    match /chat/{channelId}/{fileName} {
      allow read: if isInstitutional();
      // `write` incluye delete y las reglas se evaluan en union, asi que el
      // `allow delete: if false` de abajo no revocaba nada: cualquier usuario
      // institucional podia borrar los adjuntos de otro. Con create/update no.
      allow create, update: if isInstitutional()
        && request.resource.size < 10 * 1024 * 1024
        && contentTypeValido();
      // El borrado lo hace la regla de ciclo de vida del bucket a los 90
      // días, no el cliente.
      allow delete: if false;
    }

    // Adjuntos de las tareas: guias, talleres, plantillas.
    //
    // LECTURA PUBLICA A PROPOSITO. La agenda del grupo se abre por QR sin
    // contrasena, porque los estudiantes y las familias no tienen cuenta
    // institucional. Si esto exigiera autenticacion, el destinatario no podria
    // abrir el archivo y la funcion no serviria de nada. Decision de Julian del
    // 5 de agosto de 2026, con la advertencia mostrada al docente al subir.
    //
    // ESCRITURA: cualquier docente institucional. No se puede afinar mas: las
    // tareas viven en Google Sheets, y las reglas de Storage solo pueden
    // consultar Firestore — no hay forma de verificar aqui quien creo la tarea.
    // Espejar las tareas a Firestore solo para esto anadiria otra fuente que se
    // desincroniza en silencio, que ya nos costo caro con las fotos.
    match /tareas/{archivo} {
      allow read: if true;
      allow create: if isInstitutional()
        && request.resource.size < 10 * 1024 * 1024
        && contentTypeValido();
      // Se sube uno nuevo, no se pisa ni se borra: la agenda ya publicada
      // seguiria apuntando al enlace viejo.
      allow update, delete: if false;
    }

    // =========================================================================
    //  BLOQUE DE STORAGE DEL MODULO DE ASISTENCIA
    //  Integrado desde el repo de asistencia (rules/asistencia.storage.rules).
    //  ESTE archivo es el que se despliega.
    // =========================================================================

    // =============================================================================
    //  BLOQUE DE REGLAS DE STORAGE DEL MODULO DE ASISTENCIA
    //
    //  Fragmento: se pega dentro del `match /b/{bucket}/o` de storage.rules de
    //  mjb-prestamos. NO lleva `rules_version` ni `service firebase.storage`.
    //
    //  ⛔ Se despliega DESDE EL REPO DE MJB. Nunca desde asistencia.
    //
    //  POR QUE ESTO ES BLOQUEANTE PARA EL PILOTO: son fotografias de menores de edad. Sin
    //  estas reglas, cualquier archivo subido al bucket queda sin control de acceso. Tienen
    //  que estar desplegadas ANTES de la primera foto real, no despues.
    //
    //  El colegio tiene la autorizacion de tratamiento (Ley 1581/2012), lo que habilita
    //  tomarlas y usarlas — no relaja quien puede verlas.
    // =============================================================================

    // Helpers propios, con prefijo `asis` para no chocar con los de prestamos.
    // Storage no comparte los helpers de Firestore: hay que consultar Firestore
    // explicitamente con firestore.get().

    function asisCaller() {
      return request.auth.token.email.lower();
    }

    function asisEsInstitucional() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && asisCaller().matches('.*@iemanueljbetancur[.]edu[.]co');
    }

    function asisUserDoc() {
      return firestore.get(/databases/(default)/documents/users/$(asisCaller())).data;
    }

    function asisActivo() {
      return asisEsInstitucional()
        && firestore.exists(/databases/(default)/documents/users/$(asisCaller()))
        && asisUserDoc().active == true;
    }

    function asisRol() {
      return asisUserDoc().role;
    }

    // Director del grupo del estudiante: mismo mecanismo que en Firestore — el documento
    // espejo asistenciaConfig/directores, cuyo campo `mapa` va de grado a slotId. El grado
    // vigente del estudiante viaja denormalizado en su ficha.
    function asisGradoDe(studentId) {
      return firestore.get(/databases/(default)/documents/asistenciaStudents/$(studentId)).data.gradoActual;
    }

    // ⚠️ TOPE DE DOS CONSULTAS A FIRESTORE POR PETICION.
    //
    // MEDIDO contra produccion el 2026-08-05, bisecando despliegue a despliegue: con 1 y
    // con 2 consultas la subida pasa; con 3 falla. Y falla con "Permission denied.", que
    // es indistinguible de un rechazo legitimo.
    //
    // NI el simulador de la consola NI el emulador aplican ese tope. Por eso la version
    // anterior —que gastaba SEIS lecturas: la cuenta del usuario cinco veces, el espejo
    // dos y la ficha dos— pasaba todas las pruebas y fallaba solo en produccion, y solo
    // para el director: el superusuario y el coordinador salian antes por el `||` y no
    // llegaban al tope. Costo dos sesiones enteras de depuracion.
    //
    // CONSECUENCIA DE DISENO: no queda presupuesto para leer `users/{correo}`, asi que la
    // autorizacion NO se compara contra el `slotId`. El espejo trae los CORREOS ya
    // resueltos, en su campo `fotos` (ver `mapaFotosPorGrado()` en directoresSync.ts).
    // Es la misma conclusion que ya estaba escrita alli para la autoridad por sede: en
    // las reglas la identidad garantizada es el correo del token.
    //
    // PRESUPUESTO: asisGradoDe (1) + el espejo (1) = 2. Ni una mas. CONTAR antes de
    // anadir cualquier condicion que lea Firestore.
    function asisPuedeEditarFotoDe(studentId) {
      return firestore.get(/databases/(default)/documents/asistenciaConfig/directores).data
          .get('fotos', {})
          .get(asisGradoDe(studentId), [])
          .hasAny([asisCaller()]);
    }

    // ---------- Fotografias de estudiantes ----------
    // CORREGIDO al integrar: venia como `{studentId}.jpg`, y Cloud Storage NO admite
    // comodines con sufijo literal — el despliegue fallaba con "Unexpected '.'". El
    // comodin captura el nombre COMPLETO del archivo y el id del estudiante se deriva
    // quitandole la extension.
    match /asistencia/photos/{archivo} {

      // Lectura para cualquier usuario institucional ACTIVO. Es deliberadamente amplia:
      // la foto se usa para verificar identidad al escanear un QR y en el plano de clase,
      // y cualquier docente puede terminar acompanando un grupo que no es el suyo. La
      // restriccion fina esta en los datos de asistencia, no en el rostro.
      //
      // Ojo con la consecuencia practica: las fotos se cachean en los dispositivos de los
      // docentes para que la app funcione sin senal. Eso es intencional y esta cubierto por
      // la autorizacion de tratamiento, pero conviene que el colegio lo sepa.
      allow read: if asisActivo() && archivo.matches('.*[.]jpg');

      // Escritura: quien figure en `fotos[grado]` del espejo — el director de ese grupo,
      // los coordinadores y el superusuario. La lista la construye `directoresSync.ts`;
      // aqui solo se compara contra el correo del token.
      //
      // CORREGIDO al integrar: era `allow write`, que en Storage incluye delete. Como las
      // reglas se evaluan en union, el `allow delete: if false` de abajo no revocaba nada y
      // el borrado quedaba permitido. Con create/update la intencion se cumple de verdad.
      //
      // NO se llama a `asisActivo()` ni se lee el rol: no hay presupuesto de consultas
      // (ver el tope arriba). No es un agujero, pero SI una concesion que hay que
      // conocer: desactivar una cuenta ya no basta para quitarle la foto — hay que
      // resincronizar el espejo, que es lo que la saca de la lista.
      //
      // PRESUPUESTO: asisPuedeEditarFotoDe gasta las 2 consultas. Cualquier condicion
      // nueva que lea Firestore rompe esto en produccion sin que ninguna prueba lo vea.
      allow create, update: if asisEsInstitucional()
        && archivo.matches('.*[.]jpg')
        && asisPuedeEditarFotoDe(archivo.split('[.]')[0])
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');

      allow delete: if false;   // se reemplaza, no se borra
    }

    // Copias previas al reemplazar una foto. Evidencia, no consulta general.
    match /asistencia/photos/history/{studentId}/{ts} {
      allow read: if asisActivo() && asisRol() in ['superusuario', 'coordinador'];
      allow write: if false;    // las escribe una Cloud Function con Admin SDK
    }

    // ---------- Archivos importados de Master2000 ----------
    // Se conservan tal como llegaron, como evidencia de que produjo cada importacion.
    // Contienen documentos de identidad en claro, asi que NO los ve nadie mas.
    match /asistencia/imports/{fileName} {
      allow read, write: if asisActivo() && asisRol() == 'superusuario';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
